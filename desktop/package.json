{
  "name": "linepulse-desktop",
  "productName": "Velox Charts",
  "version": "1.4.1",
  "description": "Velox Charts — Multi-Screen Live Trading Charts & FXReplay Backtest",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "sync": "node sync-assets.mjs",
    "dev": "LINEPULSE_PERSONAL_DEV=1 electron .",
    "dev:clean": "electron .",
    "build:mac": "node sync-assets.mjs && electron-builder --mac",
    "build:mac:public": "node sync-assets.mjs && electron-builder --mac dmg --config.artifactName='VeloxCharts-${version}-Public-${arch}.${ext}'",
    "build:mac:personal": "node sync-assets.mjs --personal && electron-builder --mac dmg --config.artifactName='VeloxCharts-${version}-Personal-DO-NOT-SHARE-${arch}.${ext}' && node sync-assets.mjs",
    "build:win": "node sync-assets.mjs && electron-builder --win",
    "build:win:zip": "node sync-assets.mjs && electron-builder --win zip --x64",
    "build:linux": "node sync-assets.mjs && electron-builder --linux",
    "build:all": "node sync-assets.mjs && electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.veloxcharts.app",
    "productName": "Velox Charts",
    "directories": {
      "output": "../dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "package.json",
      "build/icon.png",
      "app-bundle/**/*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "linux": {
      "category": "Finance",
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
